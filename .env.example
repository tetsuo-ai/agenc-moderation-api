# --- signer (required to record attestations; omit for verdict-only mode) ---
# Base58 64-byte secret key OR a Solana keypair-file JSON array. The key must
# be the cluster's global moderation_authority OR a registered, non-revoked
# roster ModerationAttestor (the service auto-detects which and attaches the
# roster PDA). NEVER commit this. Prefer your platform's secret store.
MODERATION_SIGNER_SECRET=

# --- chain ---
RPC_URL=https://api.mainnet-beta.solana.com
CLUSTER_LABEL=mainnet

# --- attestation expiry (seconds; 0 disables — on-chain expires_at=0) ---
ATTESTATION_TTL_SECONDS=2592000

# --- retrievability gate (every attestation implies retrievable content) ---
# Job-spec registry checked/pinned BEFORE any attestation is recorded. A task
# attestation is refused (SPEC_NOT_RETRIEVABLE, 409, retryable) unless the spec
# is fetchable at <registry>/api/job-specs/<hash>, fetchable at an https
# specUri, or pinnable by this service. (http:// is tolerated for
# localnet/dev registries — see scripts/localnet-proof.mjs.)
JOB_SPEC_REGISTRY_URL=https://marketplace.agenc.tech
# Optional operator write token for registry pins (sent as a Bearer header).
# Leave empty to mint wallet-scoped upload tickets with the moderation signer
# key instead (an off-chain signature — no SOL moves, no transaction).
JOB_SPEC_REGISTRY_TOKEN=

# --- who pays for an approval ---
# The program takes a deposit from the recording signer for every new approval
# record, and never returns it. By default the CALLER pays it: a request names
# the wallet that pays (`payer`) and gets the approval back as a transaction
# for that wallet to sign and send, and this signer spends nothing. A request
# with no `payer` is refused (HTTP 402). Set to false only if you want this
# signer to pay for every approval itself, as the service used to.
REQUESTER_PAYS=true

# --- weekly moderation liveness heartbeat (program revision 9) ---
# Off unless set to true. Sends a plain moderation_heartbeat (never a window
# change) about once a week, only on a revision 9 program and only when this
# signer is the moderation authority, the config authority or a protocol
# owner. Each heartbeat costs this signer one fee (about 5,000 lamports).
# Self-host: the server checks hourly. Vercel: vercel.json calls
# GET /v1/cron/heartbeat daily, authorized by CRON_SECRET.
HEARTBEAT_ENABLED=false
# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`. Required for
# the HTTP trigger when the heartbeat is on; keep it in the secret store.
CRON_SECRET=

# --- abuse bounds (with REQUESTER_PAYS=false each CLEAN attest signs + pays a mainnet tx) ---
RATE_LIMIT_PER_IP=6
RATE_LIMIT_GLOBAL=60
RATE_LIMIT_WINDOW_MS=60000

# Optional shared cross-instance limiter (Upstash Redis REST). Falls back to a
# bounded per-instance window when unset.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional bearer API keys (comma-separated). When set, POST endpoints require
# Authorization: Bearer <key>. Leave empty for an open, rate-limited service.
ATTEST_API_KEYS=

# Self-host port
PORT=8787
