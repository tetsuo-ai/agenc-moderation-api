NODE_ENV=production
HOST=127.0.0.1
PORT=8787
RPC_URL=https://your-rpc.example
CLUSTER_LABEL=mainnet
MODERATION_SIGNER_SECRET_FILE=/run/credentials/agenc-attestor.service/moderation.key
VERDICT_KEY_FILE=/run/credentials/agenc-attestor.service/verdict.pem
KEY_MANIFEST_FILE=/etc/agenc-attestor/keys.json
ROOT_PUBLIC_KEY=REPLACE_WITH_BASE58_OFFLINE_ROOT_PUBLIC_KEY
ATTESTATION_DB_PATH=/var/lib/agenc-attestor/attestations.sqlite
TRUST_PROXY=0
ENABLE_SPEC_PINNING=0
JOB_SPEC_REGISTRY_URL=https://marketplace.agenc.tech
CREATOR_DAILY_INTAKES=20
CREATOR_HOURLY_TASKS=5
CREATOR_OUTSTANDING_TRANSACTIONS=5
ATTESTATION_SERVICE_FEE_LAMPORTS=0
RATE_LIMIT_PER_IP=6
RATE_LIMIT_GLOBAL=60
