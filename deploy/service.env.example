RPC_URL=https://your-read-and-submit-rpc.example
CLUSTER_LABEL=mainnet
ROOT_PUBLIC_KEY=REPLACE_WITH_OFFLINE_ROOT_BASE58_PUBLIC_KEY
JOB_SPEC_REGISTRY_URL=https://marketplace.agenc.tech
ENABLE_SPEC_PINNING=0
CREATOR_DAILY_INTAKES=20
CREATOR_HOURLY_TASKS=5
SPEND_HOURLY_LAMPORTS=30000000
SPEND_DAILY_LAMPORTS=150000000
WALLET_FLOOR_LAMPORTS=100000000
RATE_LIMIT_PER_IP=6
RATE_LIMIT_GLOBAL=60

# Public worker allowlist, separate from the root-signed V manifest.
WORKER_KEYS_FILE=/etc/agenc-attestor/workers.json
WORKER_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_QUALIFIED_IMAGE_DIGEST
